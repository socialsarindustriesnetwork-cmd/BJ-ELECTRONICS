# BJ Electronics administration application — Hostinger production variables
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_STORE_URL=https://www.bjelectronics.shop
NEXT_PUBLIC_ADMIN_URL=https://admin.bjelectronics.shop
NEXT_PUBLIC_APP_URL=https://admin.bjelectronics.shop

AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://user:password@host:5432/bj_electronics
DB_POOL_MAX=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
REALTIME_POLL_INTERVAL_MS=1500

ALLOW_PUBLIC_SIGNUP=true
ADMIN_BOOTSTRAP_EMAILS=owner@bjelectronics.shop

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_API_VERSION=

# Set to the deployed Git commit and deployment timestamp when supported.
RELEASE_SHA=
RELEASE_VERSION=1.0.0
RELEASE_DEPLOYED_AT=
