# Public application origin. The requested domain spelling is preserved.
NEXT_PUBLIC_APP_URL=https://www.bjelecteonics.shop

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL connection used by authentication and future commerce modules.
DATABASE_URL=postgresql://user:password@host:5432/bj_electronics
DB_POOL_MAX=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Set false after the initial administrator account is created when invitations are preferred.
ALLOW_PUBLIC_SIGNUP=true

# Optional GitHub Actions production verification URL.
HOSTINGER_PRODUCTION_URL=https://www.bjelecteonics.shop
