# Public production origin used for metadata and generated absolute URLs.
NEXT_PUBLIC_APP_URL=https://www.bjelecteonics.shop

# Hostinger sets PORT automatically for managed Node.js web apps.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Reserved for the next backend implementation phase.
DATABASE_URL=postgresql://user:password@localhost:5432/bj_electronics
REDIS_URL=redis://localhost:6379
