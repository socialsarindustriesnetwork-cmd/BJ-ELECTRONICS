# Public canonical application origin.
NEXT_PUBLIC_APP_URL=https://bjelectronics.shop

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL connection used by authentication and commerce modules.
DATABASE_URL=postgresql://user:password@host:5432/bj_electronics
DB_POOL_MAX=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Keep true only while approved accounts are being created.
ALLOW_PUBLIC_SIGNUP=true

# Comma-separated owner emails allowed to create the first SUPER_ADMIN account.
ADMIN_BOOTSTRAP_EMAILS=owner@bjelectronics.shop

# Google OAuth web application credentials.
# Authorized redirect URI:
# https://bjelectronics.shop/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta/Facebook Login credentials.
# Valid OAuth redirect URI:
# https://bjelectronics.shop/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Use the Graph API version configured for the Meta app, for example vNN.N.
FACEBOOK_GRAPH_API_VERSION=

# Optional GitHub Actions production verification URL.
HOSTINGER_PRODUCTION_URL=https://bjelectronics.shop
